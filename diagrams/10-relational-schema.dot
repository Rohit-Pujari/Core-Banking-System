digraph G { graph [rankdir=LR, bgcolor="#ffffff", pad="0.5", nodesep="0.55", ranksep="1.0", fontname="DejaVu Sans", fontsize=18]; node [shape=box, style="rounded,filled", fillcolor="#edf5ef", color="#a8c4b0", fontname="DejaVu Sans", fontsize=12, margin="0.2,0.15"]; edge [color="#597766", fontname="DejaVu Sans", fontsize=10, arrowsize=0.8];
graph [label="Vault — Relational schema", labelloc=t];
branches [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>branches</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">name : text</TD></TR><TR><TD ALIGN="LEFT">city : text</TD></TR><TR><TD ALIGN="LEFT">FK parent_id : integer (nullable)</TD></TR></TABLE>>];
customers [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">name : text</TD></TR><TR><TD ALIGN="LEFT">UK email : text</TD></TR><TR><TD ALIGN="LEFT">phone : text</TD></TR><TR><TD ALIGN="LEFT">kyc : jsonb</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR></TABLE>>];
accounts [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>accounts</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">UK number : text</TD></TR><TR><TD ALIGN="LEFT">FK customer_id : integer</TD></TR><TR><TD ALIGN="LEFT">FK branch_id : integer</TD></TR><TR><TD ALIGN="LEFT">kind : Savings / Current</TD></TR><TR><TD ALIGN="LEFT">balance : numeric(16,2), &gt;= 0</TD></TR><TR><TD ALIGN="LEFT">status : Active / Frozen / Closed</TD></TR></TABLE>>];
transfers [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>transfers</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">FK from_account : integer</TD></TR><TR><TD ALIGN="LEFT">FK to_account : integer</TD></TR><TR><TD ALIGN="LEFT">amount : numeric(16,2), &gt; 0</TD></TR><TR><TD ALIGN="LEFT">narration : text</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR></TABLE>>];
audit_log [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">FK account_id : integer</TD></TR><TR><TD ALIGN="LEFT">old_balance : numeric(16,2)</TD></TR><TR><TD ALIGN="LEFT">new_balance : numeric(16,2)</TD></TR><TR><TD ALIGN="LEFT">actor : text (database user)</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR></TABLE>>];
loans [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>loans</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">FK customer_id : integer</TD></TR><TR><TD ALIGN="LEFT">kind : text</TD></TR><TR><TD ALIGN="LEFT">principal : numeric(16,2)</TD></TR><TR><TD ALIGN="LEFT">rate : numeric(5,2)</TD></TR><TR><TD ALIGN="LEFT">months : integer</TD></TR><TR><TD ALIGN="LEFT">status : Active / Pending / Closed / Rejected</TD></TR><TR><TD ALIGN="LEFT">FK reviewed_by : integer (nullable)</TD></TR><TR><TD ALIGN="LEFT">reviewed_at : timestamptz (nullable)</TD></TR></TABLE>>];
app_users [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>app_users</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id : integer</TD></TR><TR><TD ALIGN="LEFT">name : text</TD></TR><TR><TD ALIGN="LEFT">UK email : text</TD></TR><TR><TD ALIGN="LEFT">password_hash : text</TD></TR><TR><TD ALIGN="LEFT">role : customer / employee / admin</TD></TR><TR><TD ALIGN="LEFT">FK, UK customer_id : integer (nullable)</TD></TR></TABLE>>];
app_sessions [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#16583e"><FONT COLOR="white"><B>app_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK token_hash : text</TD></TR><TR><TD ALIGN="LEFT">FK user_id : integer (delete cascade)</TD></TR><TR><TD ALIGN="LEFT">expires_at : timestamptz</TD></TR><TR><TD ALIGN="LEFT">created_at : timestamptz</TD></TR></TABLE>>];
branches -> branches [label="parent_id", taillabel="0..1", headlabel="0..*", labeldistance=2];
branches -> accounts [label="branch_id", taillabel="1", headlabel="0..*", labeldistance=2];
customers -> accounts [label="customer_id", taillabel="1", headlabel="0..*", labeldistance=2];
customers -> loans [label="customer_id", taillabel="1", headlabel="0..*", labeldistance=2];
accounts -> transfers [label="from_account", taillabel="1", headlabel="0..*", labeldistance=2];
accounts -> transfers [label="to_account", taillabel="1", headlabel="0..*", labeldistance=2];
accounts -> audit_log [label="account_id", taillabel="1", headlabel="0..*", labeldistance=2];
customers -> app_users [label="customer_id", taillabel="0..1", headlabel="0..1", labeldistance=2];
app_users -> loans [label="reviewed_by", taillabel="0..1", headlabel="0..*", labeldistance=2];
app_users -> app_sessions [label="user_id", taillabel="1", headlabel="0..*", labeldistance=2];
legend [fillcolor="#fff5df", label="PK = primary key | FK = foreign key | UK = unique\nEdges point from referenced table to referencing table.\nMultiplicity at each end: 1 = exactly one; 0..1 = optional; 0..* = zero or more.\nCustomer logins require customer_id; employee/admin logins have no customer_id.\nEight application tables; schema_version is an internal migration tracker."];
}