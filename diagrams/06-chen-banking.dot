graph ER {
graph [label="Bank accounts and transfers — Chen ER", labelloc=t, fontsize=22, fontname="Arial", bgcolor="white", pad=0.45, nodesep=0.4, ranksep=1.0, overlap=false, splines=true];
node [fontname="Arial", fontsize=13, style=filled, fillcolor="#d7ead0", color="#333333"];
edge [fontname="Arial", fontsize=11, color="#333333"];
Customer [shape=box, label="Customer", margin="0.18,0.12"];
Customer_customer_id [shape=ellipse,label=<<U>customer_id</U>>]; Customer -- Customer_customer_id;
Customer_name [shape=ellipse,label="name"]; Customer -- Customer_name;
Customer_email [shape=ellipse,label="email"]; Customer -- Customer_email;
Customer_phone [shape=ellipse,label="phone"]; Customer -- Customer_phone;
Customer_created_at [shape=ellipse,label="created_at"]; Customer -- Customer_created_at;
Customer_KYC [shape=ellipse,label="KYC"]; Customer -- Customer_KYC;
kyc_verified [shape=ellipse,label="verified"]; Customer_KYC -- kyc_verified;
kyc_occupation [shape=ellipse,label="occupation"]; Customer_KYC -- kyc_occupation;
kyc_risk [shape=ellipse,label="risk"]; Customer_KYC -- kyc_risk;
Branch [shape=box, label="Branch", margin="0.18,0.12"];
Branch_branch_id [shape=ellipse,label=<<U>branch_id</U>>]; Branch -- Branch_branch_id;
Branch_name [shape=ellipse,label="name"]; Branch -- Branch_name;
Branch_city [shape=ellipse,label="city"]; Branch -- Branch_city;
Account [shape=box, label="Account", margin="0.18,0.12"];
Account_account_id [shape=ellipse,label=<<U>account_id</U>>]; Account -- Account_account_id;
Account_account_number [shape=ellipse,label="account_number"]; Account -- Account_account_number;
Account_kind [shape=ellipse,label="kind"]; Account -- Account_kind;
Account_balance [shape=ellipse,label="balance"]; Account -- Account_balance;
Account_status [shape=ellipse,label="status"]; Account -- Account_status;
Transfer [shape=box, label="Transfer", margin="0.18,0.12"];
Transfer_transfer_id [shape=ellipse,label=<<U>transfer_id</U>>]; Transfer -- Transfer_transfer_id;
Transfer_amount [shape=ellipse,label="amount"]; Transfer -- Transfer_amount;
Transfer_narration [shape=ellipse,label="narration"]; Transfer -- Transfer_narration;
Transfer_created_at [shape=ellipse,label="created_at"]; Transfer -- Transfer_created_at;
Balance_Audit [shape=box, label="Balance Audit", margin="0.18,0.12"];
Balance_Audit_audit_id [shape=ellipse,label=<<U>audit_id</U>>]; Balance_Audit -- Balance_Audit_audit_id;
Balance_Audit_old_balance [shape=ellipse,label="old_balance"]; Balance_Audit -- Balance_Audit_old_balance;
Balance_Audit_new_balance [shape=ellipse,label="new_balance"]; Balance_Audit -- Balance_Audit_new_balance;
Balance_Audit_actor [shape=ellipse,label="actor"]; Balance_Audit -- Balance_Audit_actor;
Balance_Audit_created_at [shape=ellipse,label="created_at"]; Balance_Audit -- Balance_Audit_created_at;
r0 [shape=diamond,label="Owns",fillcolor="#e5efdf",height=0.7];
Customer -- r0 [label="(0,N)"]; r0 -- Account [label="(1,1)"];
r1 [shape=diamond,label="Maintains",fillcolor="#e5efdf",height=0.7];
Branch -- r1 [label="(0,N)"]; r1 -- Account [label="(1,1)"];
r2 [shape=diamond,label="Sends",fillcolor="#e5efdf",height=0.7];
Account -- r2 [label="(0,N)"]; r2 -- Transfer [label="(1,1)"];
r3 [shape=diamond,label="Receives",fillcolor="#e5efdf",height=0.7];
Account -- r3 [label="(0,N)"]; r3 -- Transfer [label="(1,1)"];
r4 [shape=diamond,label="Records",fillcolor="#e5efdf",height=0.7];
Account -- r4 [label="(0,N)"]; r4 -- Balance_Audit [label="(1,1)"];
r9 [shape=diamond,label="Parent of",fillcolor="#e5efdf",height=0.7];
Branch -- r9 [label="parent (0,N)"]; r9 -- Branch [label="child (0,1)"];
}